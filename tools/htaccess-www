# Gehört als ".htaccess" in das Hauptverzeichnis des Strato-Webspace.
#
# www.orca.gmbh zeigt auf den Webspace und dient dort nur einem Zweck: Es nimmt
# das Kontaktformular an (kontakt.php). Die Website selbst liegt unter
# orca.gmbh bei GitHub Pages. Wer also www aufruft, wird dorthin geschickt —
# sonst stünde er vor einem leeren Verzeichnis.
#
# Die erste Bedingung begrenzt das auf den Namen www.orca.gmbh. Andere Domains,
# die auf denselben Webspace zeigen, bleiben unberührt.

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.orca\.gmbh$ [NC]
RewriteCond %{REQUEST_URI} !^/kontakt\.php$
RewriteRule ^(.*)$ https://orca.gmbh/$1 [R=301,L]
</IfModule>

# Verzeichnisinhalte nicht auflisten, falls doch einmal ein Ordner
# ohne Startseite aufgerufen wird.
Options -Indexes
